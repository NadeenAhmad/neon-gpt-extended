# NeOn-GPT example environment configuration
# Copy this file to .env and replace the placeholder values.

# Shared runtime configuration
NEON_LLM_PROVIDER=openrouter
NEON_MODEL=deepseek/deepseek-v3.2-exp
NEON_API_KEY=your_api_key_here
NEON_API_BASE=https://openrouter.ai/api/v1/chat/completions

# OpenRouter-specific overrides
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=deepseek/deepseek-v3.2-exp

# OpenAI-specific overrides
OPENAI_API_KEY=your_openai_key_here
OPENAI_API_BASE=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI-specific overrides
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Optional legacy compatibility variables
API_KEY=your_api_key_here
MODEL=deepseek/deepseek-v3.2-exp
LLM_PROVIDER=openrouter
